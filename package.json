{
  "name": "ddot",
  "displayName": "ddot.it: Knowledge Graphs",
  "description": "Authoring support for ddot.it — a minimal notation for knowledge graphs.",
  "publisher": "calpano",
  "version": "0.0.5",
  "engines": { "vscode": "^1.76.0" },
  "icon": "icon-128.png",
  "categories": ["Programming Languages", "Snippets"],
  "keywords": ["ddot.it", "triple", "graph", "semantic", "linked data", "syntax", "knowledge graph", "ontology", "ddot ..works.. everywhere"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Calpano/ddot.it-vscode"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "typescript": "^4.9.5",
    "@types/node": "^18.16.0",
    "@types/vscode": "^1.76.0"
  },
  "activationEvents": ["onLanguage:ddot.it", "workspaceContains:**/*.ddot"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ddot.it",
        "aliases": ["ddot.it","ddot"],
        "extensions": [".ddot"],
        "icon": {
          "light": "./icon-dark.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ddot.it",
        "scopeName": "source.ddot",
        "path": "./syntaxes/ddot.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ddot.it",
        "path": "./snippets/ddot.json"
      }
    ],
    "commands": [
      {
        "command": "ddot.validate",
        "title": "ddot.it: Validate Document",
        "description": "Validate the current ddot.it document for syntax errors"
      },
      {
        "command": "ddot.format",
        "title": "ddot.it: Format Document",
        "description": "Format the current ddot.it document"
      },
      {
        "command": "ddot.exportJson",
        "title": "ddot.it: Export as JSON",
        "description": "Export the current ddot.it document as a JSON representation"
      }
    ]
  }
}
